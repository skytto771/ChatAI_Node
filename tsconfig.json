{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "module": "commonjs",
        "types": ["node"],
        // 编译根目录
        "rootDir": "./src",
        // 编译输出目录
        "outDir": "./dist",
        // 是否移除注释
        "removeComments": false,
        // 生成声明文件
        "declaration": true,
        // 跳过库检查
        "skipLibCheck": true,
        // ES 模块互操作
        "esModuleInterop": true,
        // 是否生成编译后的文件
        "noEmit": false,
        // 有错误时是否生成编译后的文件
        "noEmitOnError": true,
        // 严格检查的总开关（全开/全关）
        "strict": true,
        // 不允许隐式any
        "noImplicitAny": true,
        // 不允许不明确类型的this
        "noImplicitThis": true,
        // 严格检查空值
        "strictNullChecks": true,
        "ignoreDeprecations":"6.0",
        "baseUrl": ".",
        "paths": {
        "@/*": ["./src/*"]
        }
    },
    "include": [
        "./src/**/*",
        "src"
    ],
    "exclude": [],
}
