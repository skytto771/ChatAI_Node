# ============================================
# 星语 (StarTalk) 后端环境变量配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# 运行环境: development | production
NODE_ENV=development

# 服务器端口
PORT=3000

# CORS 允许的前端来源（开发环境）
CORS_ORIGIN=http://localhost:5173

# 日志级别: debug | info | warn | error
LOG_LEVEL=debug

# ============ 数据库 ============
DB_HOST=localhost
DB_USERNAME=root
DB_PASSWORD=your_db_password
DB_DATABASE=chatwithai

# ============ JWT ============
# 生产环境请使用强随机字符串（至少 32 位）
JWT_SECRET=your_jwt_secret_key_change_me

# ============ DeepSeek AI ============
OPENAI_DEEPSEEK_API_KEY=sk-your_deepseek_api_key

# ============ 管理员账号 ============
ADMIN_PASSWORD=your_admin_password

# ============ 邮件服务（SMTP）============
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
